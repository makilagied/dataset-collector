DATABASE_URL=postgresql+psycopg://collector:collector@localhost:5432/collector
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI=
IG_WEBHOOK_VERIFY_TOKEN=
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENC_KEY=
# HMAC key: python -c "import secrets; print(secrets.token_hex(32))"
AUTHOR_HASH_KEY=
GRAPH_API_VERSION=v25.0
# Optional: app secret of a Facebook Login app, if its webhooks also post here.
FB_APP_SECRET=

# Admin UI at http://localhost:8000/admin (user "admin"). Empty password = UI disabled.
# Only reachable locally; set ADMIN_ALLOW_REMOTE=true to allow access through ngrok.
ADMIN_PASSWORD=
ADMIN_ALLOW_REMOTE=false

# ngrok tunnel (development). Free account: https://dashboard.ngrok.com
# Authtoken: dashboard -> Your Authtoken. Domain: dashboard -> Domains (one free static domain).
NGROK_AUTHTOKEN=
NGROK_DOMAIN=


# Store only comments with an abusive word (a lexicon hit), from every source.
STORE_ONLY_HITS=true
# Keep one comment per set of hit words; repeats raise the stored comment's count instead.
DEDUPE_HITS=true
# Most requests a scrape makes in any rolling hour (0 = no cap); keeps Instagram from
# rate limiting (HTTP 429) the logged-in session on long runs.
SCRAPE_MAX_REQUESTS_PER_HOUR=600
